<?xml version="1.0"?>
<ruleset name="LotoSorter">
    <description>PSR-12 coding style</description>
    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>public</file>
    <file>sort_donation.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
