{
    "name": "gloas/loto-sorter",
    "description": "Sort a CSV of donations into balanced Loto rounds, from the command line or a web interface",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "php-di/php-di": "^7.0",
        "psr/clock": "^1.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "LotoSorter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LotoSorter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "sort": "php sort_donation.php",
        "serve": "php -S localhost:8080 -t public -d upload_max_filesize=2M -d post_max_size=40M -d max_file_uploads=20",
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "sort": "Sort a CSV of donations: composer sort -- all.csv",
        "serve": "Start the web interface on http://localhost:8080",
        "test": "Run the test suite",
        "lint": "Check the PSR-12 coding style",
        "lint:fix": "Fix the PSR-12 coding style",
        "analyse": "Run the static analysis",
        "check": "Run the coding style, static analysis and tests"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
