<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LotoSorter{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <style>
        details > summary { cursor: pointer; }
        .lot-card .list-group-item { font-size: .9rem; }
    </style>
</head>
<body class="bg-body-tertiary">
<nav class="navbar bg-primary mb-4" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="{{ url_for('home') }}">LotoSorter</a>
        <span class="navbar-text small">Tri automatique des lots du loto</span>
    </div>
</nav>
<main class="container pb-5">
    {% block content %}{% endblock %}
</main>
<footer class="container pb-4 small text-body-secondary">
    Les fichiers envoyés sont traités en mémoire et ne sont jamais conservés sur le serveur.
    · <a href="https://github.com/Gloas/LotoSorter">Code source</a>
</footer>
</body>
</html>
