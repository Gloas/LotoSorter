{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as format %}

{% set result = report.result %}
{% set tolerance = report.config.policy.toleranceBelow %}
{% set game_icons = {adult: 'cup-straw', kid: 'balloon'} %}
{% set stats = [
    ['Dons lus', result.donationCount, 'gift', 'text-primary'],
    ['Dons placés', result.sortedCount, 'emoji-laughing', 'text-success'],
    ['Dons restants', result.unsortedCount, 'piggy-bank', 'text-warning'],
    ['Essais', result.attempts, 'arrow-repeat', 'text-secondary'],
] %}

{% block title %}Résultat du tri · LotoSorter{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-trophy text-warning" aria-hidden="true"></i> Résultat du tri</h1>
        <a class="btn btn-outline-secondary" href="{{ url_for('home') }}"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Nouveau tri</a>
    </div>

    <div class="row g-3 mb-4">
        {% for stat in stats %}
            <div class="col-6 col-md-3">
                <div class="card card-body d-flex flex-row align-items-center gap-3">
                    <i class="bi bi-{{ stat[2] }} stat-icon {{ stat[3] }}" aria-hidden="true"></i>
                    <div>
                        <div class="text-body-secondary small">{{ stat[0] }}</div>
                        <div class="fs-4 fw-semibold">{{ stat[1] }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title"><i class="bi bi-download" aria-hidden="true"></i> Télécharger</h2>
            <p class="small text-body-secondary">
                Importer « Tout en un » dans Google Sheets (<em>Fichier &gt; Importer &gt; Insérer de nouvelles feuilles</em>) :
                les totaux « Mise de » y sont des formules.
            </p>
            {% for file in downloads %}
                <a class="btn {{ loop.first ? 'btn-primary' : 'btn-outline-primary' }} me-2 mb-2"
                   href="{{ file.url }}" download="{{ file.name }}"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> {{ file.title }}</a>
            {% endfor %}
            <details class="mt-2">
                <summary class="small">Résumé du tri</summary>
                <pre class="small mt-2 mb-0">{{ report.summary|join("\n") }}</pre>
            </details>
        </div>
    </div>

    {% for grid in result.grids %}
        <h2 class="h4 mt-4"><i class="bi bi-{{ game_icons[grid.audience.value] }} text-primary" aria-hidden="true"></i>
            Parties {{ grid.audience.pluralLabel|lower }}</h2>
        {% for round in grid.rounds %}
            <h3 class="h6 mt-3 text-body-secondary"><i class="bi bi-ticket-perforated" aria-hidden="true"></i> Partie n°{{ round.number }}</h3>
            <div class="row g-3">
                {% for lot in round.lots %}
                    <div class="col-lg-4">{% include '_lot.html.twig' %}</div>
                {% endfor %}
            </div>
        {% endfor %}
        {% if grid.extraLots is not empty %}
            <h3 class="h6 mt-3 text-body-secondary"><i class="bi bi-stars" aria-hidden="true"></i> Lots spéciaux</h3>
            <div class="row g-3">
                {% for lot in grid.extraLots %}
                    <div class="col-lg-4">{% include '_lot.html.twig' %}</div>
                {% endfor %}
            </div>
        {% endif %}
    {% endfor %}

    <h2 class="h4 mt-5"><i class="bi bi-piggy-bank text-warning" aria-hidden="true"></i> Dons non placés ({{ result.unsortedCount }})</h2>
    {% if result.unsorted is empty %}
        <p><i class="bi bi-emoji-sunglasses text-success" aria-hidden="true"></i> Tous les dons ont été placés, bravo !</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle bg-body">
                <thead><tr><th>Donateur</th><th>Libellé</th><th>Public</th><th class="text-end">Montant</th></tr></thead>
                <tbody>
                {% for donation in result.unsorted %}
                    <tr>
                        <td>{{ donation.donor }}</td>
                        <td>{{ donation.label }}</td>
                        <td>{{ donation.audience ? donation.audience.label : '?' }}</td>
                        <td class="text-end text-nowrap">{{ format.amount(donation.amount) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
